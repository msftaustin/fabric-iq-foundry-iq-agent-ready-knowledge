# Temporary and locally generated files
*.bak
*.tmp

# OS files
.DS_Store
Thumbs.db

# IDE files (except .vscode/mcp.json which we want)
.idea/
*.swp
*.swo

# Environment files with secrets
.env
.env.local
.env.*.local

# Source material kept out of the published repository
_remove-before-publish/*
!_remove-before-publish/README.md

# Dependencies (if applicable)
node_modules/
__pycache__/
*.pyc
.venv/

# Generated setup logs
*.log
